  },
  {
   "pass_name": "prose",
   "answer": "{\n  \"blocks\": [\n    {\n      \"kind\": \"paragraph\",\n      \"lines\": [\n        \"We recommend that the roof is renewed before the coming winter and that the remaining items, set out in the cost\",\n        \"schedule, are programmed over the next three years. We would be glad to prepare a specification for the roof works and\",\n        \"to obtain competitive tenders on your behalf.\"\n      ]\n    }\n  ]\n}",
