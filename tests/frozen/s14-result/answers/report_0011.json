   "answer": "{\n  \"blocks\": [\n    {\n      \"kind\": \"heading\",\n      \"lines\": [\n        \"2. Traffic and revenue\"\n      ]\n    },\n    {\n      \"kind\": \"paragraph\",\n      \"lines\": [\n        \"Vessel movements rose by four per cent against a national decline of two. The gain is attributable almost entirely to the aggregates berth, which operated for eleven months against seven in the prior year.\"\n      ]\n    }\n  ]\n}",
