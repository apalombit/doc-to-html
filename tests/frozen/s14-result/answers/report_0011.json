   "answer": "{\n  \"blocks\": [\n    {\n      \"kind\": \"heading\",\n      \"lines\": [\n        \"1.1 Basis of preparation\"\n      ]\n    },\n    {\n      \"kind\": \"paragraph\",\n      \"lines\": [\n        \"Figures are stated on an accruals basis and are drawn from the audited accounts. Where a figure differs from the one published last year it has been restated, and the restatement is noted.\"\n      ]\n    }\n  ]\n}",
   "truncated": false,
   "error": null,
