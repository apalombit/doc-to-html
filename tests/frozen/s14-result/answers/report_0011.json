  {
   "pass_name": "prose",
   "answer": "{\n  \"blocks\": [\n    {\n      \"kind\": \"heading\",\n      \"lines\": [\n        \"1.1.1 Treatment of dredging costs\"\n      ]\n    },\n    {\n      \"kind\": \"paragraph\",\n      \"lines\": [\n        \"Dredging was previously written off in the year incurred. From this year it is capitalised over the interval between campaigns,\",\n        \"which is five years on the main channel and three on the inner basin.\"\n      ]\n    }\n  ]\n}",
   "truncated": false,
