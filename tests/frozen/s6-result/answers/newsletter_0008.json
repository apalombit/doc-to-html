   "answer": "{\n  \"blocks\": [\n    {\n      \"kind\": \"heading\",\n      \"lines\": [\n        \"WHAT REOPENS, AND WHEN\"\n      ]\n    },\n    {\n      \"kind\": \"paragraph\",\n      \"lines\": [\n        \"The towpath itself opens on the first. The two slip-\",\n        \"ways follow a fortnight later, once the new\",\n        \"handrails have been tested. The boathouse café,\",\n        \"closed since the scaffolding went up, expects to\",\n        \"trade again before the half-term holiday.\"\n      ]\n    }\n  ]\n}",
