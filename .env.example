# doc-to-html configuration
#
#   cp .env.example .env      then edit .env, which is gitignored
#
# Every value here has a working default in code; this file exists so a model
# or a host can be changed without editing Python. See docs/status.md for what
# actually reads these today.

# --- Ollama ---------------------------------------------------------------
# Local by default. Point OLLAMA_HOST at Ollama Cloud and set OLLAMA_API_KEY to
# run the same pipeline against hosted models.
#
# Note this is a change of *host*, not of trust boundary: with a cloud host,
# every Source Image leaves the machine. See docs/adr/0003 on why the local
# posture was chosen.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# --- Models, per role -----------------------------------------------------
# One model in every role today. The roles are separate settings because they
# are separable questions, not because they currently differ — the Orchestrator
# batches by model, and two vision models cannot stay resident in 8 GB.
#
# The 8 GB M1 budget is roughly 4 GB of weights: qwen3-vl:2b (1.9 GB),
# qwen3-vl:4b (3.3 GB) and granite3.2-vision (2.4 GB) are in range;
# deepseek-ocr (6.7 GB) is not and will swap.
DTH_LAYOUT_MODEL=qwen3-vl:4b
DTH_EXTRACT_MODEL=qwen3-vl:4b

# A placeholder. Nothing loads this: the Coverage Audit is a no-op and
# audit_coverage() raises, so the value is never sent anywhere — which is why it
# can name the model already on disk instead of a second family the machine has
# no room for.
#
# It is the wrong model for the job and must be re-pointed before that audit is
# built. The audit catches content no Zone covers, and it is worth something
# only from a *different* family: asking the model that missed a block whether
# it missed a block shares the blind spot that caused the miss. granite3.2-vision
# (2.4 GB) was the previous default and is the obvious candidate to reinstate.
DTH_AUDIT_MODEL=qwen3-vl:4b

# Which model decides each Zone's Kind, from that Zone's own crop. The same
# model as the other two for now, so a document still costs one model load.
#
# It is a separate setting because the roles are separable, not because they
# currently differ: a model that locates blocks well and one that reads them
# well need not be the same, and this is where that gets tried. Measured so far
# (issue #13): asked what invoice.png's payment block is, qwen3-vl:4b answers
# "pairs" at every resolution it was offered, while qwen3.5:4b answers "table"
# once it sees the full-resolution crop. So this default leaves that Zone wrong.
#
# qwen3.5:4b has never run the layout pass or been measured on the other four
# fixtures, which is why it is not the default on the strength of that one
# result. Evaluating models per step, and combinations across steps, is #19.
DTH_CLASSIFY_MODEL=qwen3-vl:4b

# Longest edge of the page image handed to the *layout* pass. Finding regions is
# coarse work and needs no glyphs, so this is deliberately smaller than what
# extraction gets — fewer image tokens leaves a small model more room to answer.
# Extraction always crops at full resolution regardless.
DTH_LAYOUT_LONG_EDGE=512

# Move each Zone's box onto its own ink before anything is asked about it. On —
# run 49 took invoice_0001 to zero mismatches with this set, and a default that
# cannot reproduce that number would be a trap.
#
# The layout pass cannot produce metric coordinates, so its boxes clip glyphs and
# swallow whitespace; snapping them to the ink takes invoice_0001 from 0.56 IoU
# against the true rectangles to 0.91, with covered 0.99 and 0 splits. That is
# geometry, though, not Kinds: run 39 converted with this on and every one of the
# six classifications came back identical to the unsnapped run, so it fixes none
# of the document's three mismatches.
#
# It was off for a real reason: runs 39 and 45 both went 3 mismatches to 6 with it
# on, the same way both times — one spurious empty row in the table extractor's
# JSON, costing Zone 5 and the column-sum Probe. Two later changes removed that
# cost. Zero-cell rows are now dropped before the width check, and
# DTH_TABLE_GRID_HINT stops the model emitting the row at all: run 49's raw
# answers carry no empty row on either table.
DTH_SNAP_ZONES=1

# Tell the table Extractor how many rows and columns it is filling in. On — it is
# the change that took invoice_0001 to zero mismatches, in run 49.
#
# Measured from the crop about to be sent — an ink projection down it for rows and
# across it for columns, no model call. invoice_0001's two tables measure 2x2 and
# 5x2; sample_table_0003 measures 16x5. All three correct.
#
# Aimed at a defect two prompt attempts could not move: a wide, short table comes
# back with every row cut in half, because its columns sit ~800px apart with
# nothing between them. Run 13 and run 48 both told the model not to split a row
# and run 48's answers were byte-identical to the run before it. A count is a
# different kind of statement — the model already obeys "give every data row the
# same number of cells as the header row" while ignoring where a line begins and
# ends — which is the only reason to expect a third attempt to land.
#
# Stated in the prompt, never enforced in the schema: a sentence survives a wrong
# number, where a schema would force the model to drop or invent content to
# satisfy one. A Zone's Title is a printed line and not a row, so with_grid
# subtracts one for a titled table — sample_table_0003 measured 17 against a true
# 16 before that correction.
DTH_TABLE_GRID_HINT=1

# Ask each Zone for its Title in its own call, before asking what Kind it is. On
# — run 82 against 81, one flag apart, took the corpus from 23 findings to 12
# and gave invoice_0001 and sample_table_0003 both as full matches. It is the
# only pass that writes zone.title on the shipped path, and it wrote 11 Titles,
# every one correct.
#
# Two questions rather than one because they want opposite pixels: the Title
# needs the caption band in frame, and the Kind is measurably wrong while it is
# there — a shaded caption bar satisfies CLASSIFY_PROMPT's own "top row set
# apart" test for a table. So the band is read first, then cropped off before
# the Kind is asked. It is also what revives with_grid(titled=), which subtracts
# a Title's printed line from a table's row count and had never fired in
# production while zone.title was always None.
#
# It costs a second call only for Zones that have a body: preprocess.caption_band
# refuses a crop holding a single band of ink, so a Zone that is only a heading
# is never asked. Over the corpus's 30 Zones that leaves 11 alone.
#
# Set to 0 for one call per Zone.
DTH_CAPTION_PASS=1

# --- Layout ---------------------------------------------------------------
# Which engine finds the Zones: a trained detector by name, or "none" for the
# vision model. Measured against each other one flag apart, all five fixtures:
# the vision path raises MappingError on three of them and matches none, while
# the detector converts all five and matches invoice_0001. It also removes the
# layout model call entirely, and gives covered 1.00 and splits 0 everywhere, so
# nothing is lost — what is left is mis-grouped, not missing.
#
# Say "none" rather than leaving it empty. An empty variable reads as unset
# everywhere in this file, so DTH_LAYOUT_DETECTOR= resolves back to the default.
DTH_LAYOUT_DETECTOR=heron

# How the detector decides a heading belongs to the region beneath it, which is
# how a Zone comes to carry a Title at all.
#
#   absolute   a fixed fraction of page height (HEADING_GAP)
#   relative   the gap below the heading against the gap above it
#
# "relative" ships, having been measured live first — run 78 against 76 one flag
# apart, then as half of the shipped pair in run 81. It is also the better rule:
# re-derived pre-snap against the fixtures' Zone contents "absolute" is wrong on
# 4 of the corpus's 14 headings, where "relative" is wrong on 2. It takes
# sample_css_0004's two cards from split to whole and changes nothing on the
# other four.
#
# Unlike the detector above, an unknown value here is an error rather than a
# fallback — a run launched as one arm that silently measured the other is worse
# than a run that refuses to start.
DTH_HEADING_RULE=relative

# Whether to adopt a low-confidence container over the stack of boxes it holds.
# Five of the nine geometry findings left on the corpus are regions the detector
# cut too fine, and in every one of them the right container is already in the
# pool — scoring 0.05 to 0.27, under the 0.40 threshold, so the nesting rule
# never saw it. Costs arithmetic and no second forward pass.
#
# On since run 81, measured live one flag apart first: run 80 against 79 took the
# corpus from 23 findings to 21 and geometry from 11 to 6, every gate holding,
# with ten fewer model calls. It ships alongside DTH_HEADING_RULE=relative rather
# than instead of it — the two tie on the count, but with this rule alone
# sample_css_0004's first card is still split.
DTH_PREFER_CONTAINER=1

# --- Inference ------------------------------------------------------------
# Context window. A table Zone sliced into overlapping strips still has to fit
# its response; too small and a long table truncates mid-array.
DTH_NUM_CTX=8192

# Seconds before a single vision pass is abandoned. Expect 10-20s per pass on
# an 8 GB M1, so this is generous on purpose.
DTH_TIMEOUT_S=180

# --- Application ----------------------------------------------------------
DTH_LOG_LEVEL=INFO
