# doc-to-html configuration
#
#   cp .env.example .env      then edit .env, which is gitignored
#
# Every value here has a working default in code; this file exists so a model
# or a host can be changed without editing Python. See docs/status.md for what
# actually reads these today.

# --- Ollama ---------------------------------------------------------------
# Local by default. Point OLLAMA_HOST at Ollama Cloud and set OLLAMA_API_KEY to
# run the same pipeline against hosted models.
#
# Note this is a change of *host*, not of trust boundary: with a cloud host,
# every Source Image leaves the machine. See docs/adr/0003 on why the local
# posture was chosen.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# --- Models, per role -----------------------------------------------------
# Layout and audit deliberately default to different model *families* so the
# Coverage Audit does not share the blind spot that caused a miss.
#
# The 8 GB M1 budget is roughly 4 GB of weights: qwen3-vl:2b (1.9 GB),
# qwen3-vl:4b (3.3 GB) and granite3.2-vision (2.4 GB) are in range;
# deepseek-ocr (6.7 GB) is not and will swap.
#
# Layout and extract sharing one model is intentional — the Orchestrator
# batches by model, and two vision models cannot stay resident in 8 GB.
DTH_LAYOUT_MODEL=qwen3-vl:4b
DTH_EXTRACT_MODEL=qwen3-vl:4b
DTH_AUDIT_MODEL=granite3.2-vision:latest

# Which model decides each Zone's Kind, from that Zone's own crop. The one role
# that does *not* default to the layout model, and the difference is measured
# rather than assumed: asked what `invoice.png`'s payment block is, qwen3-vl:4b
# answers "pairs" at every resolution it was offered, while qwen3.5:4b answers
# "table" once it sees the full-resolution crop. Neither the crop alone nor the
# model alone gets that Zone right. See issue #13.
#
# 3.4 GB, so it fits the same budget — but not at the same time as the layout
# model, so a document costs two model loads. Set it to qwen3-vl:4b to spend one
# instead, and expect that Zone to stay wrong.
DTH_CLASSIFY_MODEL=qwen3.5:4b

# Longest edge of the page image handed to the *layout* pass. Finding regions is
# coarse work and needs no glyphs, so this is deliberately smaller than what
# extraction gets — fewer image tokens leaves a small model more room to answer.
# Extraction always crops at full resolution regardless.
DTH_LAYOUT_LONG_EDGE=512

# --- Inference ------------------------------------------------------------
# Context window. A table Zone sliced into overlapping strips still has to fit
# its response; too small and a long table truncates mid-array.
DTH_NUM_CTX=8192

# Seconds before a single vision pass is abandoned. Expect 10-20s per pass on
# an 8 GB M1, so this is generous on purpose.
DTH_TIMEOUT_S=180

# --- Application ----------------------------------------------------------
DTH_LOG_LEVEL=INFO
